{
  "name": "scarincihollenbeck.frontend.cc",
  "version": "1.2.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack -p 7700",
    "build": "next build --webpack && node scripts/check-client-bundle.js",
    "start": "next start -p 7300",
    "lint": " eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky install",
    "knip": "knip",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e",
    "analyze": "cross-env ANALYZE=true yarn build"
  },
  "lint-staged": {
    "*.js": [
      "yarn format",
      "yarn lint",
      "eslint --cache --fix"
    ],
    "*css": [
      "yarn format"
    ]
  },
  "license": "ISC",
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "opera >= 79",
    "not dead",
    "not ie 11"
  ],
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.5",
    "@next/third-parties": "16.4.3",
    "@reduxjs/toolkit": "^2.13.0",
    "algoliasearch": "^4.10.5",
    "bootstrap": "^5.2.0",
    "framer-motion": "^12.38.0",
    "html-react-parser": "5.2.17",
    "is-empty": "^1.2.0",
    "kwesforms": "^2.2.2",
    "lodash.throttle": "^4.1.1",
    "next": "16.4.3",
    "node-fetch": "2.7.0",
    "nprogress": "^0.2.0",
    "react": "19.2.9",
    "react-bootstrap": "2.10.10",
    "react-cookie-consent": "8.0.1",
    "react-dom": "19.2.9",
    "react-icons": "^4.12.0",
    "react-instantsearch": "7.53.0",
    "react-is": "19.2.9",
    "react-redux": "^9.3.1",
    "react-responsive": "^9.0.0",
    "react-share": "5.2.2",
    "react-spinners": "0.17.0",
    "react-swipeable": "^7.0.2",
    "sharp": "^0.33.2",
    "styled-components": "^5.3.0",
    "swiper": "^11.1.4"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@next/bundle-analyzer": "16.4.3",
    "@next/env": "16.4.3",
    "@next/eslint-plugin-next": "^12.0.7",
    "@playwright/test": "^1.61.1",
    "cross-env": "^10.1.0",
    "eslint": "^7.5.0",
    "eslint-config-airbnb": "^18.2.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-jsx-a11y": "^6.3.1",
    "eslint-plugin-react": "^7.20.3",
    "eslint-plugin-react-hooks": "^4.0.8",
    "husky": "^7.0.0",
    "knip": "^5.85.0",
    "lint-staged": "^11.1.2",
    "prettier": "^2.2.1",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "jquery": "^3.5.0",
    "**/instantsearch.js/react": "19.2.9"
  }
}
